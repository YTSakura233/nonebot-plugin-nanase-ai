# Copy to your NoneBot bot's .env; do not commit actual credentials.
SORUTO_DEEPSEEK_API_KEY=""
SORUTO_DB_HOST="localhost"
SORUTO_DB_PORT=3306
SORUTO_DB_USER=""
SORUTO_DB_PASSWORD=""
SORUTO_DB_NAME=""
SORUTO_ALLOWED_GROUPS=[123456789]
SORUTO_BANNED_USERS=[]

SORUTO_SIMPLE_MODELS=["deepseek-flash"]
SORUTO_COMPLEX_MODELS=["deepseek-v4-pro"]
SORUTO_VISION_MODELS=["deepseek-flash"]
SORUTO_FALLBACK_MODELS=[]
SORUTO_ENABLE_TOOLS=true
SORUTO_LLM_DEADLINE_SECONDS=90
SORUTO_CASUAL_DEADLINE_SECONDS=20
SORUTO_CASUAL_MAX_AGENT_STEPS=3
SORUTO_MAX_AGENT_STEPS=10
SORUTO_MAX_TOOL_CALLS=12
SORUTO_MODEL_CONCURRENCY=8

# Paths are on the BOT HOST; these directories are optional.
# SORUTO_SKILLS_DIR="./skills"
# SORUTO_ENABLED_SKILLS=["your-skill-name"]
# SORUTO_KNOWLEDGE_DIR="./knowledge"
# SORUTO_KNOWLEDGE_COLLECTIONS=["default"]
SORUTO_KNOWLEDGE_QUERY_EXPANSION=true
SORUTO_MCP_SERVERS={}
SORUTO_CASUAL_TOOL_NAMES=["web_search","web_fetch"]
SORUTO_ENABLE_HELP_ALIAS=true
